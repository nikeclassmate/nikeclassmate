#!/usr/bin/python3
import sys
counts = {}
for line in sys.stdin:
    word, count = line.strip().split('\t')
    counts[word] = counts.get(word, 0) + int(count)
for word, count in counts.items():
    print("%s\t%s" % (word, count))
