y = prepped_df['NObeyesdad']
X = x   # FIX: later cells use capital X, which was never defined in the original

# splitting data
x_train, x_test, y_train, y_test = train_test_split(x, y, test_size=0.2, random_state=42, stratify=y)

# Training one vs all logistic regression model
model_ova = OneVsRestClassifier(
    LogisticRegression(max_iter=1000)
)

model_ova.fit(x_train, y_train)

y_pred_ova = model_ova.predict(x_test)

# Evaluation metrics for OvA
print("One vs All Strategy")
print(f"Accuracy:{np.round(100*accuracy_score(y_test, y_pred_ova), 2)}%")

model_ovo = OneVsOneClassifier(LogisticRegression(max_iter=1000))
model_ovo.fit(x_train, y_train)

y_pred_ovo = model_ovo.predict(x_test)

# Evaluation metrics for OvO
print("One vs One Strategy")   # FIX: label said "One vs All"
print(f"Accuracy:{np.round(100*accuracy_score(y_test, y_pred_ovo), 2)}%")

test_sizes = [0.1, 0.2, 0.3]

results = []

for test_size in test_sizes:

    # Split the data
    X_train, X_test, y_train, y_test = train_test_split(
        X, y,
        test_size=test_size,
        random_state=42,
        stratify=y
    )

    # Train One-vs-All Logistic Regression
    model = LogisticRegression(
        multi_class='ovr',
        max_iter=1000
    )

    model.fit(X_train, y_train)

    # Predictions
    y_pred = model.predict(X_test)

    # Accuracy
    accuracy = accuracy_score(y_test, y_pred)

    # Store results
    results.append({
        'Test Size': test_size,
        'Train Size': 1 - test_size,
        'Accuracy': accuracy
    })

