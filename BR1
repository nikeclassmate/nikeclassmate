cat_col = scaled_df.select_dtypes(include=['object']).columns.tolist()
cat_col.remove('NObeyesdad')  # Exclude target variable

encoder = OneHotEncoder(sparse_output=False, drop='first')
encoded_features = encoder.fit_transform(scaled_df[cat_col])

encoded_df = pd.DataFrame(encoded_features, columns=encoder.get_feature_names_out(cat_col))

prepped_df = pd.concat([scaled_df.drop(columns=cat_col), encoded_df], axis=1)

prepped_df['NObeyesdad'] = prepped_df['NObeyesdad'].astype('category').cat.codes
prepped_df.head()

