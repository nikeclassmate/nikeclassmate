customers["Age"] = customers["Age"].fillna(customers["Age"].median())
customers["Salary"] = customers["Salary"].fillna(customers["Salary"].median())

print(customers.head())

# standardization (inter quatile range can also be taken)
scaler = StandardScaler()
customers[["Age", "Salary"]] = scaler.fit_transform(customers[["Age", "Salary"]])
print(customers.head())

combined = pd.merge(customers, purchases, on="CustomerID", how="inner")
print(combined.head())

# 1a - remove exact duplicate rows
before = len(customers)
df = customers.drop_duplicates(subset="CustomerID", keep="first")
print(f"(a) Removed duplicates: {before}-> {len(df)} rows")

# 1b - standardize inconsistent categorical text
df["City"] = df["City"].str.strip().str.title()
print("(b) Standardized 'City' text casing:")
print(df["City"].unique())

# 1c- Handle missing values
df["Name"] = df["Name"].fillna("Unknown")
df["Age"] = df["Age"].fillna(df["Age"].median())
df["Salary"] = df["Salary"].fillna(df["Salary"].median())
print("\n(c) Missing values after imputation:")
print(df.isnull().sum())

# 1d- Handle outliers using IQR method
def cap_outliers_iqr(series):
    q1, q3 = series.quantile([0.25, 0.75])
    iqr = q3 - q1
    lower, upper = q1 - 1.5 * iqr, q3 + 1.5 * iqr
    return series.clip(lower, upper)

print("\n(d) Outlier capping (IQR method) on Age and Salary:")
print("Before->", df[["Age", "Salary"]].describe().loc[["min", "max"]].to_dict())
df["Age"] = cap_outliers_iqr(df["Age"])
df["Salary"] = cap_outliers_iqr(df["Salary"])
print("After ->", df[["Age", "Salary"]].describe().loc[["min", "max"]].to_dict())

print("\nCleaned dataset:")
print(df)

df_purchases = pd.DataFrame(purchases)
print("Second source (Purchases table):")
print(df_purchases)

df_integrated = pd.merge(df, df_purchases, on="CustomerID", how="left")

df_integrated["TotalPurchases"] = df_integrated["TotalPurchases"].fillna(0)
df_integrated["MemberSince"] = df_integrated["MemberSince"].fillna(df_integrated["MemberSince"].median())

# Loyalty Points based on Total Purchases
df_integrated.loc[(df_integrated["TotalPurchases"] >= 1) & (df_integrated["TotalPurchases"] <= 5), "LoyaltyPoints"] = 1
df_integrated.loc[(df_integrated["TotalPurchases"] >= 6) & (df_integrated["TotalPurchases"] <= 10), "LoyaltyPoints"] = 2
df_integrated.loc[(df_integrated["TotalPurchases"] >= 11) & (df_integrated["TotalPurchases"] <= 15), "LoyaltyPoints"] = 3
df_integrated.loc[(df_integrated["TotalPurchases"] >= 16) & (df_integrated["TotalPurchases"] <= 20), "LoyaltyPoints"] = 4

# Loyalty Group
group_map = {
    1: "Bronze",
    2: "Silver",
    3: "Gold",
    4: "Platinum"
}

# Cashback
cashback_map = {
    1: 100,
    2: 200,
    3: 300,
    4: 400
}

df_integrated["LoyaltyGroup"] = df_integrated["LoyaltyPoints"].map(group_map)
df_integrated["Cashback"] = df_integrated["LoyaltyPoints"].map(cashback_map)

current_year = 2026
df_integrated["MembershipYears"] = current_year - df_integrated["MemberSince"]

# Active if the customer averages at least 1 purchase per year
purchase_rate = (
    df_integrated["TotalPurchases"] /
    df_integrated["MembershipYears"]
)

df_integrated["MembershipStatus"] = np.where(
    purchase_rate >= 1,
    "Active",
    "Inactive"
)

print("\nIntegrated dataset (customer+purchase info merged on Customer ID):")
print(df_integrated)

# data transformation
df_t = df_integrated.copy()

# 3a - Normalization (Min-max scaling :0,1)- useful for distance based models
minmax = MinMaxScaler()
df_t[["Age_MinMax", "Salary_MinMax"]] = minmax.fit_transform(df_t[["Age", "Salary"]])

# 3b - Standardization
zscore = StandardScaler()
df_t[["Age_Z", "Salary_Z"]] = zscore.fit_transform(df_t[["Age", "Salary"]])

# 3c - Encoding categorical variables
le = LabelEncoder()
df_t["Gender_Encoded"] = le.fit_transform(df_t["Gender"])
df_t = pd.get_dummies(df_t, columns=["City"], prefix="City")

# 3d - discretization/binning - convert continuous age into categorical buckets
bins = [0, 25, 35, 50, 100]
labels = ["Young", "Adult", "MidAge", "Senior"]
df_t["Age_Group"] = pd.cut(df_integrated["Age"], bins=bins, labels=labels)

print("Transformed dataset (scaled, encoded and binned):")
show_cols = ["CustomerID", "Age", "Age_MinMax", "Age_Z", "Age_Group", "Salary",
             "Salary_MinMax", "Salary_Z", "Gender", "Gender_Encoded"]
print(df_t[show_cols])

print("\nOne-hot encoded City columns added:")
