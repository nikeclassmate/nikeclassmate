
from pyspark import SparkContext
from pyspark.sql import SQLContext

# Start Spark
sc = SparkContext()
sql = SQLContext(sc)

# Create RDD
rdd = sc.parallelize([
    (1, "AIML", 69),
    (2, "CS", 72),
    (3, "ECE", 99)
])

# Convert RDD to DataFrame
df = sql.createDataFrame(
    rdd, ["No", "Dept", "No_of_students"]
)

# Show output on screen
df.show()

sc.stop()

spark-submit   rdd.py
