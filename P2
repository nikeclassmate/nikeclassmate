# 2. Create Mapper
gedit mapper2.py

# Mapper code:
#!/usr/bin/env python
import sys
import csv

reader = csv.reader(sys.stdin)

for line in reader:
    # line[1] is gender, line[2] is age
    if len(line) > 2:
        print('%s,%s' % (line[1], line[2]))

